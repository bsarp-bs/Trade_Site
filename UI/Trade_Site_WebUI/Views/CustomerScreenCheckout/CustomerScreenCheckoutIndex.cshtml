@model Trade_Site_WebUI_Dto_Layer.UI_Demand_DTOs.UI_CheckoutViewModel
@{
    ViewData["Title"] = "CustomerScreenCheckoutIndex";
    Layout = "~/Views/Layout/LayoutIndex.cshtml";
}

<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" asp-controller="CustomerScreen" asp-action="CustomerScreenIndex">Home</a>
                <a class="breadcrumb-item text-dark" asp-controller="CustomerScreenShoppingCart" asp-action="CustomerScreenShoppingCartIndex">Cart</a>
                <span class="breadcrumb-item active">Checkout</span>
            </nav>
        </div>
    </div>
</div>

<div class="container-fluid">
    <form method="post" asp-controller="CustomerScreenCheckout" asp-action="CustomerScreenCheckoutIndex">
        <div class="row px-xl-5">
            <div class="col-lg-8">
                <div class="mb-5">
                    <h5 class="section-title position-relative text-uppercase mb-3">
                        <span class="bg-secondary pr-3">Billing Address</span>
                    </h5>

                    <div class="bg-light p-30">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label asp-for="City"></label>
                                <input asp-for="City" class="form-control" placeholder="City">
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 form-group">
                                <label asp-for="District"></label>
                                <input asp-for="District" class="form-control" placeholder="District">
                                <span asp-validation-for="District" class="text-danger"></span>
                            </div>

                            <div class="col-md-12 form-group">
                                <label asp-for="Desc">Address Detail</label>
                                <textarea asp-for="Desc" class="form-control" rows="5" placeholder="Address detail"></textarea>
                                <span asp-validation-for="Desc" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="mb-5">
                    <h5 class="section-title position-relative text-uppercase mb-3">
                        <span class="bg-secondary pr-3">Order Total</span>
                    </h5>

                    <div class="bg-light p-30">
                        <div class="border-bottom">
                            <h6 class="mb-3">Products</h6>

                            @if (Model.Cart?.CartItems != null && Model.Cart.CartItems.Any())
                            {
                                foreach (var item in Model.Cart.CartItems)
                                {
                                    <div class="d-flex justify-content-between">
                                        <p>@item.ProductName x @item.Quantity</p>
                                        <p>$@(item.Price * item.Quantity)</p>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="d-flex justify-content-between">
                                    <p>Cart is empty</p>
                                    <p>$0</p>
                                </div>
                            }
                        </div>

                        <div class="border-bottom pt-3 pb-2">
                            <div class="d-flex justify-content-between mb-3">
                                <h6>Subtotal</h6>
                                <h6>$@(Model.Cart?.TotalPrice ?? 0)</h6>
                            </div>
                            <div class="d-flex justify-content-between">
                                <h6 class="font-weight-medium">Shipping</h6>
                                <h6 class="font-weight-medium">$0</h6>
                            </div>
                        </div>

                        <div class="pt-2">
                            <div class="d-flex justify-content-between mt-2">
                                <h5>Total</h5>
                                <h5>$@(Model.Cart?.TotalPrice ?? 0)</h5>
                            </div>

                            @if (Model.Cart?.CartItems != null && Model.Cart.CartItems.Any())
                            {
                                <button type="submit" class="btn btn-block btn-primary font-weight-bold my-3 py-3">
                                    Place Order
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-block btn-secondary font-weight-bold my-3 py-3" disabled>
                                    Cart Is Empty
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}