@model List<Trade_Site_WebUI_Dto_Layer.UI_Demand_DTOs.UI_GetOrderDetailDto>

@{
    ViewData["Title"] = "OrderDetail";
    Layout = "~/Views/Layout/LayoutIndex.cshtml";
}

<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" asp-controller="CustomerScreen" asp-action="CustomerScreenIndex">Home</a>
                <a class="breadcrumb-item text-dark" asp-controller="CustomerScreenOrder" asp-action="MyOrders">My Orders</a>
                <span class="breadcrumb-item active">Order Detail</span>
            </nav>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-lg-12 table-responsive mb-5">
            <h4 class="mb-3">Order No: @ViewBag.OrderMainID</h4>
            <p class="mb-3">
                Status:
                <span class="badge badge-warning px-3 py-2">@ViewBag.OrderStatus</span>
            </p>

            <table class="table table-light table-borderless table-hover text-center mb-0">
                <thead class="thead-dark">
                    <tr>
                        <th>Product Name</th>
                        <th>Price</th>
                        <th>Amount</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody class="align-middle">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle">@item.ProductName</td>
                                <td class="align-middle">$@item.ProductPrice</td>
                                <td class="align-middle">@item.ProductAmount</td>
                                <td class="align-middle">$@item.ProductTotalPrice</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">Bu siparise ait urun bulunamadi.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
