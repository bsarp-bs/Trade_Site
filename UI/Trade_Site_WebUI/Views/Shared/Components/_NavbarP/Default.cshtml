@model List<Trade_Site_WebUI_Dto_Layer.UI_Category_DTOs.UI_ShowCategoryDto>

<div class="container-fluid bg-dark mb-30">
    <div class="row px-xl-5">
        <div class="col-lg-3 d-none d-lg-block">
            <a class="btn d-flex align-items-center justify-content-between bg-primary w-100" data-toggle="collapse" href="#navbar-vertical" style="height: 65px; padding: 0 30px;">
                <h6 class="text-dark m-0"><i class="fa fa-bars mr-2"></i>Categories</h6>
                <i class="fa fa-angle-down text-dark"></i>
            </a>
            <nav class="collapse position-absolute navbar navbar-vertical navbar-light align-items-start p-0 bg-light" id="navbar-vertical" style="width: calc(100% - 30px); z-index: 999;">
                <div class="navbar-nav w-100">
                    @foreach (var item in Model)
                    {
                        <a href="~/CustomerScreenProductList/CustomerScreenProductListIndex/@item.CategoryID" class="nav-item nav-link">@item.CategoryName</a>
                    }
                </div>
            </nav>
        </div>
        <div class="col-lg-9">
            <nav class="navbar navbar-expand-lg bg-dark navbar-dark py-3 py-lg-0 px-0">
                <a href="" class="text-decoration-none d-block d-lg-none">
                    <span class="h1 text-uppercase text-dark bg-light px-2">Multi</span>
                    <span class="h1 text-uppercase text-light bg-primary px-2 ml-n1">Shop</span>
                </a>
                <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-between" id="navbarCollapse">
                    <div class="navbar-nav mr-auto py-0">
                        <a href="~/CustomerScreen/CustomerScreenIndex" class="nav-item nav-link">Home</a>
                        <div class="nav-item dropdown">
                            <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">Pages <i class="fa fa-angle-down mt-1"></i></a>
                            <div class="dropdown-menu bg-primary rounded-0 border-0 m-0">
                                <a asp-controller="CustomerScreenShoppingCart" asp-action="CustomerScreenShoppingCartIndex" class="dropdown-item">Shopping Cart</a>
                                <a asp-controller="CustomerScreenCheckout" asp-action="CustomerScreenCheckoutIndex" class="dropdown-item">Checkout</a>
                                <a asp-controller="CustomerScreenOrder" asp-action="MyOrders" class="dropdown-item">My Orders</a>
                            </div>
                        </div>
                        @if (!(User.Identity?.IsAuthenticated ?? false))
                        {
                            <a asp-controller="Account" asp-action="Login" class="nav-item nav-link">Login/Register</a>
                        }
                        else
                        {
                            <span class="nav-item nav-link text-primary">@User.Identity?.Name</span>
                        }

                    </div>
                    <div class="navbar-nav ml-auto py-0 d-none d-lg-block">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <a href="/Profile/Index" class="btn px-0 mr-3">
                                <i class="fas fa-user-circle text-primary fa-lg"></i>
                            </a>
                            <a href="" class="btn px-0">
                                <i class="fas fa-heart text-primary"></i>
                                <span class="badge text-secondary border border-secondary rounded-circle" style="padding-bottom: 2px;">
                                    @await Component.InvokeAsync("_CSCartCountP")
                                </span>
                            </a>
                            <a asp-controller="CustomerScreenShoppingCart" asp-action="CustomerScreenShoppingCartIndex" class="btn px-0 ml-3">
                                <i class="fas fa-shopping-cart text-primary"></i>
                                <span class="badge text-secondary border border-secondary rounded-circle" style="padding-bottom: 2px;">
                                    @await Component.InvokeAsync("_CSCartCountP")
                                </span>
                            </a>
                            <a href="/Account/Logout" class="btn px-0 ml-3 text-danger">
                                <i class="fas fa-sign-out-alt"></i>
                                <span class="ml-1">Logout</span>
                            </a>
                        }
                    </div>
                </div>
            </nav>
        </div>
    </div>
</div>
