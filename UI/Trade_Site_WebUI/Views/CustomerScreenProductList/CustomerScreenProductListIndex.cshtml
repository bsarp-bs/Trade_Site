
@{
    ViewData["Title"] = "CustomerScreenProductListIndex";
    Layout = "~/Views/Layout/LayoutIndex.cshtml";
}

<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="#">Home</a>
                <a class="breadcrumb-item text-dark" href="#">Shop</a>
                <span class="breadcrumb-item active">Shop List</span>
            </nav>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->
<!-- Shop Start -->
<div class="container-fluid">
    <div class="row px-xl-5">

        <!-- Shop Filter Sidebar Start -->
        <div class="col-lg-3 col-md-4">
            
            @await Component.InvokeAsync("_PriceFilterP")

            @await Component.InvokeAsync("_ColorFilterP")

            @await Component.InvokeAsync("_SizeFilterP")

        </div>
        <!-- Shop Filter Sidebar End -->

        <!-- Shop Product Start -->

        <div class="col-lg-9 col-md-8">
            <div class="row pb-3">

                @await Component.InvokeAsync("_ShortsP")

                @await Component.InvokeAsync("_CSProductListP", new { id = ViewBag.i })

                <div class="col-12">
                    <nav>
                        <ul class="pagination justify-content-center">
                            <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                            <li class="page-item"><a class="page-link" href="#">Next</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>

        <!-- Shop Product End -->
    </div>
</div>
<!-- Shop End -->

