@model List<Trade_Site_WebUI_Dto_Layer.UI_Comment_DTOs.UI_ShowCommentDto>
@{
    ViewData["Title"] = "AdminCommentIndex";
    Layout = "~/Areas/AdminArea/Views/AdminLayout/AdminLayoutIndex.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Bordered Table</h4>
                <p>Add <code>.table-bordered</code> for borders on all sides of the table and cells.</p>
                <div class="bs-example" data-example-id="bordered-table">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Comment Owner</th>
                                <th>Owner Img</th>
                                <th>Emaıl</th>
                                <th>Comment Detail</th>
                                <th>Comment Rating</th>
                                <th>Comment Date</th>
                                <th>Product Name</th>
                                <th>Delete</th>
                                <th>Update</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.CommentID</td>
                                    <td>@item.NameSurname</td>
                                    <td><img src="@item.ImgUrl" alt="Owner Image" width="50" height="50" /></td>
                                    <td>@item.Email</td>
                                    <td>@item.CommentDetail</td>
                                    <td>@item.Rating</td>
                                    <td>@item.CommentDate</td>
                                    <td>@item.ProductName</td>
                                    <td><a href="~/AdminArea/AdminComment/DeleteComment/@item.CommentID">Delete</a></td>
                                    <td><a href="~/AdminArea/AdminComment/UpdateComment/@item.CommentID">Update</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <a href="~/AdminArea/AdminComment/AddComment" class="btn btn-primary">Add Comment</a>

                </div>
            </div>
        </div>
    </div>
</section>

