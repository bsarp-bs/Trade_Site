@model Trade_Site_WebUI_Dto_Layer.UI_Comment_DTOs.UI_UpdateCommentDto
@{
    ViewData["Title"] = "UpdateComment";
    Layout = "~/Areas/AdminArea/Views/AdminLayout/AdminLayoutIndex.cshtml";
}

<div class="card">
    <div class="col-md-12">
        <div class="card-body">

            <h4 class="card-title">Add Comment</h4>
            <form class="forms-sample"
                  method="post"
                  asp-area="AdminArea"
                  asp-action="AddComment"
                  asp-controller="AdminComment">

                  <input asp-for="CommentID" type="hidden" />

                <div class="form-group">
                    <label asp-for="NameSurname"></label>
                    <input asp-for="NameSurname" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="ImgUrl"></label>
                    <input asp-for="ImgUrl" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="CommentDetail"></label>
                    <input asp-for="CommentDetail" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="Rating"></label>
                    <input asp-for="Rating" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="CommentDate"></label>
                    <input asp-for="CommentDate" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="ProductID"></label>
                    <select asp-for="ProductID" asp-items="ViewBag.Products" class="form-control">
                        <option value="">Ürün Seçiniz</option>
                    </select>
                </div>


                <button type="submit" class="btn btn-outline-primary">Submit</button>

            </form>

        </div>
    </div>
</div>

