@model List<Trade_Site_WebUI_Dto_Layer.UI_ProductInfo_DTOs.UI_GetProductInfoDto>
@{
    ViewData["Title"] = "AdminProductInfoIndex";
    Layout = "~/Areas/AdminArea/Views/AdminLayout/AdminLayoutIndex.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Bordered Table</h4>
                <p>Add <code>.table-bordered</code> for borders on all sides of the table and cells.</p>
                <div class="bs-example" data-example-id="bordered-table">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Product ID</th>
                                <th>Product Description</th>
                                <th>Product Detail Description</th>
                                <th>Delete</th>
                                <th>Update</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ProductInfoID</td>
                                    <td>@item.ProductName</td>
                                    <td>@item.ProductDesc</td>
                                    <td>@item.ProductDetailDesc</td>
                                    <td><a href="~/AdminArea/AdminProductInfo/DeleteProductInfo/@item.ProductInfoID">Delete</a></td>
                                    <td><a href="~/AdminArea/AdminProductInfo/UpdateProductInfo/@item.ProductInfoID">Update</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <a href="~/AdminArea/AdminProductInfo/AddProductInfo" class="btn btn-primary">Add Product Info</a>

                </div>
            </div>
        </div>
    </div>
</section>


