@model Trade_Site_WebUI_Dto_Layer.UI_ProductInfo_DTOs.UI_UpdateProductInfoDto
@{
    ViewData["Title"] = "UpdateProductInfo";
    Layout = "~/Areas/AdminArea/Views/AdminLayout/AdminLayoutIndex.cshtml";
}

<div class="card">
    <div class="col-md-12">
        <div class="card-body">

            <h4 class="card-title">Update Product</h4>
            <form class="forms-sample"
                  method="post"
                  asp-area="AdminArea"
                  asp-action="UpdateProductInfo"
                  asp-controller="AdminProductInfo">

                  <input asp-for="ProductInfoID" type="hidden" />

                  
                <div class="form-group">
                    <label asp-for="ProductID"></label>
                    <select asp-for="ProductID" asp-items="ViewBag.ProductsList" class="form-control">
                        <option value="">Ürün Seçiniz</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="ProductDesc"></label>
                    <textarea asp-for="ProductDesc" class="form-control" rows="4"></textarea>
                </div>

                <div class="form-group">
                    <label asp-for="ProductDetailDesc"></label>
                    <textarea asp-for="ProductDetailDesc" class="form-control" rows="6"></textarea>
                </div>


                <button type="submit" class="btn btn-outline-primary">Submit</button>

            </form>

        </div>
    </div>
</div>

