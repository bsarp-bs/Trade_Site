@model List<Trade_Site_WebUI_Dto_Layer.UI_Product_DTOs.UI_ShowProductDto>
@{
    ViewData["Title"] = "AdminProductIndex";
    Layout = "~/Areas/AdminArea/Views/AdminLayout/AdminLayoutIndex.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Bordered Table</h4>
                <p>Add <code>.table-bordered</code> for borders on all sides of the table and cells.</p>
                <div class="bs-example" data-example-id="bordered-table">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Product Name</th>
                                <th>Product Price</th>
                                <th>Category Name</th>
                                <th>Delete</th>
                                <th>Update</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ProductID</td>
                                    <td>@item.ProductName</td>
                                    <td>@item.ProductPrice</td>
                                    <td>@item.CategoryName</td>
                                    <td><a href="~/AdminArea/AdminProduct/DeleteProduct/@item.ProductID">Delete</a></td>
                                    <td><a href="~/AdminArea/AdminProduct/UpdateProduct/@item.ProductID">Update</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <a href="~/AdminArea/AdminProduct/AddProduct" class="btn btn-primary">Add Product</a>

                </div>
            </div>
        </div>
    </div>
</section>
